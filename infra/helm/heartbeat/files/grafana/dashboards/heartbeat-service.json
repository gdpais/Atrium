      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(heartbeat_collector_cycles_total{outcome!=\"on_time\",collector=~\"$collector\"}[1h])) / sum(rate(heartbeat_collector_cycles_total{collector=~\"$collector\"}[1h]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
