    {
      "type": "table",
      "title": "Applications",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (environment, application, platform, criticality, status, managed_by) (heartbeat_api_inventory_application_info{environment=~\"$environment\"})",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (environment, application, platform, criticality, status, managed_by) (heartbeat_api_inventory_application_info{environment=~\"$environment\"} * on (environment, application) group_left () count by (environment, application) (max by (environment, application, source_type, ingest_mode, application_name) (heartbeat_api_inventory_source_info{environment=~\"$environment\",status=\"active\"})))",
          "refId": "B",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (environment, application, platform, criticality, status, managed_by) (heartbeat_api_inventory_application_info{environment=~\"$environment\"} * on (environment, application) group_left () count by (environment, application) (max by (environment, application, source_type, ingest_mode, application_name) (heartbeat_api_inventory_source_info{environment=~\"$environment\",status=\"active\",observation=\"observed\"})))",
          "refId": "C",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "status"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "active": {
                        "color": "green",
                        "index": 0
                      },
                      "disabled": {
                        "color": "text",
                        "index": 1
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "managed_by"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "config": {
                        "color": "blue",
                        "index": 0
                      },
                      "api": {
                        "color": "text",
                        "index": 1
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "environment",
            "desc": false
          }
        ]
      },
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value #A": true
            },
            "renameByName": {
              "Value #B": "Active sources",
              "Value #C": "Observed"
            }
          }
        }
      ],
      "description": "Every application of the selected environments, active or disabled, with who manages it (config: the environment's inventory file; api: the API's endpoints) and its active telemetry sources. Open the sources below for their health and links.",
      "id": 9,
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 6
      }
    },
    {
      "type": "row",
      "title": "Telemetry sources",
      "collapsed": false,
      "panels": [],
      "id": 10,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 14
      }
    },
    {
      "type": "table",
      "title": "Telemetry sources",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (environment, application, application_name, source_type, ingest_mode, status, managed_by, observation) (heartbeat_api_inventory_source_info{environment=~\"$environment\"})",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (environment, application, application_name, source_type, ingest_mode, status, managed_by, observation) (heartbeat_api_inventory_source_info{environment=~\"$environment\",ingest_mode=\"agentless\"} * on (environment, application_name) group_left () sum without (application) (label_replace(sum by (environment, application) (rate(heartbeat_outsystems_operations_total{environment=~\"$environment\",log_type=~\"screen|mobile_request|integration\"}[5m])), \"application_name\", \"$1\", \"application\", \"(.*)\")))",
          "refId": "B",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (environment, application, application_name, source_type, ingest_mode, status, managed_by, observation) (heartbeat_api_inventory_source_info{environment=~\"$environment\",ingest_mode=\"agentless\"} * on (environment, application_name) group_left () sum without (application) (label_replace((sum by (environment, application) (rate(heartbeat_outsystems_operations_total{environment=~\"$environment\",log_type=~\"screen|mobile_request|integration\",outcome=\"error\"}[5m])) / sum by (environment, application) (rate(heartbeat_outsystems_operations_total{environment=~\"$environment\",log_type=~\"screen|mobile_request|integration\"}[5m]))), \"application_name\", \"$1\", \"application\", \"(.*)\")))",
          "refId": "C",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (environment, application, application_name, source_type, ingest_mode, status, managed_by, observation) (heartbeat_api_inventory_source_info{environment=~\"$environment\",ingest_mode=\"agentless\",observation=\"observed\"} * on (environment) group_left () max by (environment) (heartbeat_outsystems_extract_lag_seconds))",
          "refId": "D",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "status"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "active": {
                        "color": "green",
                        "index": 0
                      },
                      "disabled": {
                        "color": "text",
                        "index": 1
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "managed_by"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "config": {
                        "color": "blue",
                        "index": 0
                      },
                      "api": {
                        "color": "text",
                        "index": 1
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "observation"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "observed": {
                        "color": "green",
                        "index": 0
                      },
                      "not_observed": {
                        "color": "orange",
                        "index": 1
                      },
                      "unknown": {
                        "color": "red",
                        "index": 2
                      },
                      "not_applicable": {
                        "color": "text",
                        "index": 3
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Requests / s"
            },
            "properties": [
              {
                "id": "unit",
                "value": "reqps"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Failed"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "decimals",
                "value": 2
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "red",
                      "value": 0.001
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Extraction lag"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 600
                    },
                    {
                      "color": "red",
                      "value": 1800
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "application_name"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "OutSystems overview",
                    "url": "/d/outsystems-overview?orgId=1&var-environment=${__data.fields.environment}&var-application=${__value.raw}&${__url_time_range}"
                  },
                  {
                    "title": "Logs in Explore",
                    "url": "/explore?orgId=1&left={\"datasource\":\"loki\",\"queries\":[{\"refId\":\"A\",\"datasource\":{\"type\":\"loki\",\"uid\":\"loki\"},\"expr\":\"{service_name=\\\"${__value.raw}\\\", deployment_environment_name=\\\"${__data.fields.environment}\\\"}\"}],\"range\":{\"from\":\"${__from}\",\"to\":\"${__to}\"}}"
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "environment",
            "desc": false
          }
        ]
      },
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value #A": true
            },
            "renameByName": {
              "Value #B": "Requests / s",
              "Value #C": "Failed",
              "Value #D": "Extraction lag"
            }
          }
        }
      ],
      "description": "Every telemetry source, with whether the collector observes it (observed; not_observed: no enabled outsystems_logs collector extracts its environment; unknown: the API could not ask the collector; not_applicable: an otlp source sends its own telemetry), and, for an agentless source, its user-facing requests and failed share over 5 minutes from the OutSystems derived metrics and, once observed, its environment's extraction lag (the oldest of its log types). application_name opens the application's OutSystems overview or its logs in Explore, the links the API renders from the outsystems-application and logs-explore templates.",
      "id": 11,
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 15
      }
    },
    {
      "type": "row",
      "title": "Database targets",
      "collapsed": false,
      "panels": [],
      "id": 12,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 24
      }
    },
    {
      "type": "table",
      "title": "Database targets",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (environment, target, engine, status, managed_by) (heartbeat_api_inventory_database_target_info{environment=~\"$environment\"})",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (environment, target, engine, status, managed_by) (heartbeat_api_inventory_database_target_info{environment=~\"$environment\"} * on (environment, target) group_left () max by (environment, target) (heartbeat_collector_target_up))",
          "refId": "B",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (environment, target, engine, status, managed_by) (heartbeat_api_inventory_database_target_info{environment=~\"$environment\"} * on (environment, target) group_left () (time() - max by (environment, target) (heartbeat_collector_target_last_success_timestamp_seconds)))",
          "refId": "C",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
