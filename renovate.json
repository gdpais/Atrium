{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Version policy: ADR 0005 (latest stable, pinned exactly, reviewed updates).",
  "extends": ["config:recommended", ":dependencyDashboard", "helpers:pinGitHubActionDigestsToSemver"],
  "schedule": ["before 6am on monday"],
  "prConcurrentLimit": 5,
  "postUpdateOptions": ["gomodTidy"],
  "packageRules": [
    {
      "description": "Batch low-risk updates into one weekly PR.",
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "non-major dependencies"
    },
    {
      "description": "GitHub Actions are pinned by commit SHA with the exact version as a comment; their non-major updates arrive in one weekly PR of their own, so CI changes are reviewed apart from code dependencies.",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
      "groupName": "GitHub Actions"
    },
    {
      "description": "Majors arrive one per PR so release notes are read one at a time.",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Keep go.mod and the Go builder images on the same release.",
      "matchPackageNames": ["go", "golang"],
      "groupName": "go toolchain"
    },
    {
      "description": "kubectl stays on the kind node's Kubernetes minor (ADR 0005): patch updates only.",
      "matchDepNames": ["kubernetes/kubernetes"],
      "matchUpdateTypes": ["major", "minor"],
      "enabled": false
    },
    {
      "description": "HELM3_VERSION only checks that the chart still renders with Helm 3; keep it on Helm 3.",
      "matchDepNames": ["helm/helm"],
      "matchCurrentValue": "/^v3\\./",
      "allowedVersions": "<4"
    },
    {
      "description": "The kind node image must match both the kind release and the newest Kubernetes minor Amazon EKS supports (ADR 0005); update it by hand from the kind release notes.",
      "matchPackageNames": ["kindest/node"],
      "enabled": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "kind CLI pin in the Makefile.",
      "managerFilePatterns": ["/^Makefile$/"],
      "matchStrings": ["KIND_VERSION := (?<currentValue>v\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "kubernetes-sigs/kind",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "Minimum Helm version in the Makefile.",
      "managerFilePatterns": ["/^Makefile$/"],
      "matchStrings": ["HELM_MIN_VERSION := (?<currentValue>v\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "helm/helm",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "Exact Helm versions CI installs (make install-tools).",
      "managerFilePatterns": ["/^Makefile$/"],
      "matchStrings": ["HELM_VERSION := (?<currentValue>v\\d+\\.\\d+\\.\\d+)", "HELM3_VERSION := (?<currentValue>v\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "helm/helm",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "kubectl version CI installs (make install-tools).",
      "managerFilePatterns": ["/^Makefile$/"],
      "matchStrings": ["KUBECTL_VERSION := (?<currentValue>v\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "kubernetes/kubernetes",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "oapi-codegen in the Makefile (make generate). A bump fails make test until the regenerated API code is committed with it.",
      "managerFilePatterns": ["/^Makefile$/"],
      "matchStrings": ["OAPI_CODEGEN_VERSION := (?<currentValue>v\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "github.com/oapi-codegen/oapi-codegen/v2",
      "datasourceTemplate": "go"
    },
    {
      "customType": "regex",
      "description": "sqlc in the Makefile (make generate). A bump fails make test until the regenerated API queries are committed with it.",
      "managerFilePatterns": ["/^Makefile$/"],
      "matchStrings": ["SQLC_VERSION := (?<currentValue>v\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "github.com/sqlc-dev/sqlc",
      "datasourceTemplate": "go"
    },
    {
      "customType": "regex",
      "description": "Valkey image of the API's integration tests; stays on the newest major Amazon ElastiCache supports (ADR 0015).",
      "managerFilePatterns": ["/^apps/api/internal/testenv/testenv\\.go$/"],
      "matchStrings": ["ValkeyImage = \"(?<depName>valkey/valkey):(?<currentValue>\\d+\\.\\d+\\.\\d+)\""],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "kind node image in the Makefile. Updates are disabled above, and Renovate leaves disabled dependencies off the dashboard, so the dashboard shows only an empty Makefile entry for it.",
      "managerFilePatterns": ["/^Makefile$/"],
      "matchStrings": ["KIND_NODE_IMAGE := (?<depName>kindest/node):(?<currentValue>v[\\d.]+)@(?<currentDigest>sha256:[a-f0-9]+)"],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Prometheus image used for promtool in the Makefile.",
      "managerFilePatterns": ["/^Makefile$/"],
      "matchStrings": ["PROMETHEUS_IMAGE := (?<depName>prom/prometheus):(?<currentValue>v\\d+\\.\\d+\\.\\d+)"],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "k6 image PatientZero's load runs on kind.",
      "managerFilePatterns": ["/^tools/patientzero/scripts/patientzero\\.sh$/"],
      "matchStrings": ["K6_IMAGE=(?<depName>grafana/k6):(?<currentValue>\\d+\\.\\d+\\.\\d+)@(?<currentDigest>sha256:[a-f0-9]+)"],
      "datasourceTemplate": "docker"
    }
  ]
}
