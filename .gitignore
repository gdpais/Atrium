.DS_Store
.env
.env.sqlserver-dev
*.log
.tmp/
coverage/
__pycache__/
.venv/
.pytest_cache/
infra/data/
.hermes/

# Dated working documents for decision review; outcomes go to docs/architecture/decisions/
docs/plans/
docs/reviews/

# HTML docs site: built by `make docs-site`, published to GitHub Pages by CI
docs/site/

# Chart dependencies: fetched by `make chart-deps` from the versions in Chart.lock
infra/helm/atrium/charts/

# Claude Code: per-session worktrees and personal settings
.claude/worktrees/
.claude/settings.local.json

# Personal local-dev config variants; the shared dev values live in infra/helm/values/
config/*.local-dev.yaml
