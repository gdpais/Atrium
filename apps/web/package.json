{
  "name": "heartbeat-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "generate": "openapi-typescript ../api/openapi.yaml -o src/api/schema.gen.ts",
    "lint": "eslint .",
    "typecheck": "tsc && tsc -p e2e",
    "test": "vitest run",
    "postinstall": "node scripts/fence-node-modules.mjs",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@mantine/core": "9.7.5",
    "@mantine/hooks": "9.7.5",
    "@tanstack/react-query": "5.105.3",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "30.1.3",
    "openapi-typescript": "7.13.0",
    "postcss": "8.5.32",
    "postcss-preset-mantine": "1.18.0",
    "postcss-simple-vars": "7.0.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
