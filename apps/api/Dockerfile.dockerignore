# The API image's build context: the root .dockerignore, but with
# db/migrations, which the API embeds (package heartbeat/db/migrations).
# BuildKit reads this file instead of the root one for apps/api/Dockerfile.
.git
.github
.tmp
.env*
docs
infra
scripts
tests
db
!db/migrations
*.md
# The Web UI's dependencies and build: the web stage installs and builds them
# from the sources, and the Go stage takes dist/app from it.
apps/web/node_modules
apps/web/dist/app
apps/web/test-results
apps/web/playwright-report
