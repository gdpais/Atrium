# Build context for the service images: Go sources only. Keeping docs, infra and
# local state out also keeps the content-derived kind image tags stable when
# only non-code files change (scripts/kind.sh).
.git
.github
.tmp
.env*
docs
infra
scripts
tests
db
*.md
# The Web UI's dependencies and build (apps/web): large, and rebuilt in the
# API image's own stage.
apps/web/node_modules
apps/web/dist/app
apps/web/test-results
apps/web/playwright-report
